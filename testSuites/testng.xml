<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Open Cart Test Regression PW Suite" thread-count="6" parallel="tests">
	
	<listeners>
		<listener class-name="com.qa.opencart.listeners.ExtentReportListener"></listener>
	</listeners>
	
  <test name="Open Cart Home Page Test_chrome">
    <parameter name="browser" value="chrome"></parameter>
    <classes>
      <class name="com.qa.opencart.tests.HomePageTests"/>
    </classes>
  </test> <!-- Test -->
  <test name="Open Cart Login Page Test_firefox">
  <parameter name="browser" value="firefox"></parameter>
    <classes>
      <class name="com.qa.opencart.tests.LoginPageTests"/>
    </classes>
  </test> <!-- Test -->
  <test name="Open Cart Home Page Test_edge">
  <parameter name="browser" value="chromium"></parameter>
    <classes>
      <class name="com.qa.opencart.tests.HomePageTests"/>
    </classes>
  </test> <!-- Test -->
  <test name="Open Cart Login Page Test_chromium">
  <parameter name="browser" value="edge"></parameter>
    <classes>
      <class name="com.qa.opencart.tests.LoginPageTests"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
